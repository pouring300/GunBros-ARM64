# ==============================================================================
# GunBros ARM64 Bridge - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the paths for your system:
#   cp .env.example .env
#
# Relative paths (starting with ./) are resolved automatically
# relative to the repository root.
# ==============================================================================

# 1. Android NDK (Required for ARM64 cross-compilation)
# Path to NDK r23c through r26d (must contain build/cmake/android.toolchain.cmake)
# Example with a local NDK inside the repo:
ANDROID_NDK_HOME="./tools/android-ndk-r26d"
# Example with the standard Android Studio / SDK NDK:
# ANDROID_NDK_HOME="$HOME/Android/Sdk/ndk/26.1.10909125"
NDK="$ANDROID_NDK_HOME"

# 2. Android SDK and Build Tools (Required for zipalign and apksigner)
# Path to the build-tools folder (containing zipalign and apksigner)
# Example with local tools inside the repo:
BUILD_TOOLS="./tools/build-tools/34.0.0"
# Example with the standard Android SDK:
# ANDROID_HOME="$HOME/Android/Sdk"
# BUILD_TOOLS="$ANDROID_HOME/build-tools/34.0.0"

# 3. Build Tools (CMake and CTest)
# If cmake and ctest are on your system PATH, you can simply use "cmake" and "ctest".
# Example using the system cmake:
CMAKE_BIN="cmake"
CTEST_BIN="ctest"
# Example using the cmake bundled in tools/:
# CMAKE_BIN="./tools/cmake/bin/cmake"
# CTEST_BIN="./tools/cmake/bin/ctest"

# 4. Emulation Dependencies (Dynarmic and Boost)
# By default these live in the repository's third_party/ folder.
DYNARMIC_ROOT="./third_party/dynarmic"
BOOST_ROOT="./third_party/boost/usr/include"

# 5. Debug Keystore for APK signing
KEYSTORE="./third_party/keystore/debug.keystore"
KEYSTORE_PASS="pass:android"

# 6. ADB Deployment Settings
# If you have multiple devices connected over USB, set the serial number here:
# ADB_SERIAL="YOUR_DEVICE_SERIAL"
# Install flags required on Android 14, 15 and 16:
ADB_INSTALL_FLAGS="--no-incremental --bypass-low-target-sdk-block -r -d"
